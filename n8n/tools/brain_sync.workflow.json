{
  "name": "Brain sync — pull from GitHub + reindex RAG",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      },
      "id": "bs-cron",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8080/tool/brain_pull",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": { "timeout": 60000 }
      },
      "onError": "continueRegularOutput",
      "id": "bs-pull",
      "name": "Hermes — brain_pull",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Hermes returns { ok, tool, result } where result is the JSON string from the tool.\nconst r = $input.first().json || {};\nlet info = {};\ntry { info = typeof r.result === 'string' ? JSON.parse(r.result) : (r.result || {}); } catch (e) { info = {}; }\nreturn [{ json: {\n  changed: !!info.changed,\n  count: info.count || 0,\n  files: info.files || [],\n  summary: info.result || r.error || 'brain_pull: no response'\n} }];"
      },
      "id": "bs-parse",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ $json.changed }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bs-if",
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4000/brain/reindex",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": { "timeout": 300000 }
      },
      "onError": "continueRegularOutput",
      "id": "bs-reindex",
      "name": "Rebeca — reindex RAG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 220],
      "credentials": { "httpHeaderAuth": { "name": "Rebeca Internal" } }
    }
  ],
  "connections": {
    "Every 15 min": { "main": [[{ "node": "Hermes — brain_pull", "type": "main", "index": 0 }]] },
    "Hermes — brain_pull": { "main": [[{ "node": "Parse result", "type": "main", "index": 0 }]] },
    "Parse result": { "main": [[{ "node": "Changed?", "type": "main", "index": 0 }]] },
    "Changed?": {
      "main": [
        [{ "node": "Rebeca — reindex RAG", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
